# apps/desktop/.env — copy to `.env` and fill in. `.env` is gitignored.
#
# Two categories of config, and the distinction matters:
#
#   MAIN_VITE_*  → BUILD-TIME. electron-vite inlines these into the bundle via
#                  import.meta.env at build. For packaged releases they must be
#                  present when `build:mac` runs — in CI they come from GitHub
#                  Actions *Variables* (see .github/workflows/release.yml). All
#                  are public (native PKCE app: no real client secret).
#
#   NEEME_*      → RUNTIME. read from process.env when the app runs. Great for
#                  `pnpm dev`, tests, and cloud agents (you export them into the
#                  shell). A double-clicked packaged app has NO shell env, so
#                  runtime-only vars don't apply there — the broker URL is also
#                  mirrored as MAIN_VITE_NEEME_SYNC_BROKER_URL for that reason.

# ── Auth (Logto OIDC, ADR 0002) ───────────────────────────────────────────────
MAIN_VITE_LOGTO_ENDPOINT=https://c435za.logto.app
MAIN_VITE_LOGTO_APP_ID=your-native-app-id
# Access-token audience. Optional when the API resource is marked "Default API"
# in Logto (tokens are JWTs by default), but set it explicitly to be safe.
MAIN_VITE_LOGTO_RESOURCE=https://api.getnimi.dev

# ── Sync token broker (ADR 0008) ──────────────────────────────────────────────
# Build-time so packaged releases can reach the broker. process.env.NEEME_SYNC_BROKER_URL
# overrides this at runtime (dev/tests).
MAIN_VITE_NEEME_SYNC_BROKER_URL=https://nimi-token-broker.vercel.app

# ── Connectors (Google OAuth: Gmail + Calendar) ───────────────────────────────
# Inert until MAIN_VITE_GOOGLE_CLIENT_ID is set.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
# MAIN_VITE_GOOGLE_SCOPES=  # optional override (default: gmail.readonly + calendar.readonly)

# ── Sync (ROADMAP #10) — RUNTIME, for local dev / spike only ───────────────────
# Sync fails closed: NEEME_SYNC=on activates sync ONLY with a valid 64-hex
# NEEME_SYNC_ENCRYPTION_KEY (otherwise stays local). The static URL/AUTH_TOKEN
# below are the pre-broker spike path; with the broker, main injects per-user
# NEEME_SYNC_URL + NEEME_SYNC_AUTH_TOKEN at boot instead.
NEEME_SYNC=off
# NEEME_SYNC_URL=libsql://<db>.turso.io
# NEEME_SYNC_AUTH_TOKEN=<turso db token>   # spike-only; broker mints this per user
# NEEME_SYNC_ENCRYPTION_KEY=<64-hex>       # REQUIRED for sync; per-user key custody is an open ADR-0008 question
# NEEME_SYNC_BROKER_URL=                   # runtime override of the build-time broker URL

# ── Embedder ──────────────────────────────────────────────────────────────────
# `hash` skips the ONNX model download (offline/CI). Omit for the real on-device model.
NEEME_EMBEDDER=hash

# ── AI drafting (ADR 0004) — RUNTIME secret, BYO key ──────────────────────────
# Absent → NullDrafter (brief/draft/note + Feed "I spotted these to-dos" degrade
# to null). A real secret: read via process.env in the worker, NEVER MAIN_VITE_,
# never in the bundle or CI build env. Export it to take effect in dev:
#   NEEME_ANTHROPIC_KEY=sk-ant-... NEEME_EMBEDDER=hash pnpm dev
# NEEME_ANTHROPIC_KEY=sk-ant-...
# NEEME_DRAFTER=off            # force NullDrafter even when a key is present
# NEEME_DRAFTER_MODEL=claude-sonnet-4-5   # override the Claude model
