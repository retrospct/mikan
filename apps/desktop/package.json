{
  "name": "@mikan/desktop",
  "version": "1.5.0",
  "description": "nimi \u2014 a privacy-first, local-first personal memory desktop app (Electron)",
  "main": "./out/main/index.js",
  "author": "jlee",
  "homepage": "https://github.com/retrospct/mikan",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test:smoke": "tsx test/smoke/capture-file.ts",
    "test:smoke:ocr": "tsx test/smoke/ocr-live.ts",
    "test:smoke:asr": "tsx test/smoke/asr-live.ts",
    "test:smoke:sync": "tsx test/smoke/sync-live.ts",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "build:mac-helper": "swiftc resources/mac/nimi-extract.swift -O -target arm64-apple-macosx13.0 -o resources/mac/nimi-extract && echo 'nimi-extract compiled'"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.4",
    "@mikan/brand": "workspace:*",
    "@mikan/contract": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.3",
    "qrcode.react": "^4.2.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
