{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    // The generated API client imports its runtime config as `'../runtime.ts'`
    // (hey-api pastes the runtimeConfigPath verbatim). tsc is typecheck-only here
    // (--noEmit); the real renderer build is esbuild/Vite, which resolves .ts natively.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The brand configs import identity.json; needed when the brand source is
    // followed from the renderer (BrandProvider) via the path map below.
    "resolveJsonModule": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@nimi/contract/*": ["../../packages/contract/src/*"],
      "@nimi/brand": ["../../packages/brand/src/index.ts"],
      "@nimi/brand/*": ["../../packages/brand/src/*"]
    }
  }
}
