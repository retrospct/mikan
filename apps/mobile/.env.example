# Legacy FastAPI client base URL — unused since the Turso migration (ADR 0009). Optional.
EXPO_PUBLIC_NEEME_API_URL=http://192.168.x.x:8000
EXPO_PUBLIC_LOGTO_ENDPOINT=https://your-tenant.logto.app
EXPO_PUBLIC_LOGTO_APP_ID=your-logto-app-id

# API resource indicator the access token is scoped to (RFC 8707). Required for
# the token broker, which JWKS-verifies a JWT with aud=<resource>. Must match the
# broker's LOGTO_AUDIENCE and a registered Logto API resource (NOT a custom domain).
EXPO_PUBLIC_LOGTO_RESOURCE=https://api.getmikan.com

# Spike: token broker URL for per-user Turso DB provisioning
# Set to the deployed broker (services/token-broker) or http://localhost:3001 for local
EXPO_PUBLIC_BROKER_URL=https://your-broker.vercel.app
