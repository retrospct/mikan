# Expo / React Native — app-local ignores.
# (node_modules and .DS_Store are covered globally by the repo-root .gitignore.)

# Expo local cache + build output (machine-local, never commit)
.expo/
dist/
web-build/

# Native build artifacts (managed → bare / prebuild via Continuous Native Generation)
/ios/
/android/

# Native signing secrets — NEVER commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro / Expo logs
npm-debug.*
*.orig.*

