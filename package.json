{
  "name": "nimi",
  "version": "1.3.0",
  "description": "nimi — a privacy-first, local-first personal memory app (monorepo root)",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "author": "jlee",
  "scripts": {
    "dev": "turbo run dev --filter=@nimi/desktop... --filter=@nimi/mastra...",
    "build": "turbo run build --filter=!@nimi/mobile",
    "typecheck": "turbo run typecheck --filter=!@nimi/mobile",
    "test": "turbo run test --filter=!@nimi/mobile",
    "dev:desktop": "turbo run dev --filter=@nimi/desktop... --filter=@nimi/token-broker...",
    "build:desktop": "turbo run build --filter=@nimi/desktop... --filter=@nimi/token-broker...",
    "dev:mobile": "turbo run dev --filter=@nimi/mobile...",
    "build:mobile": "turbo run build --filter=@nimi/mobile...",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "gen:api": "pnpm --filter @nimi/contract gen:api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
