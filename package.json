{
  "name": "mikan",
  "version": "1.5.0",
  "description": "mikan — a privacy-first, local-first personal memory app (monorepo root)",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24"
  },
  "author": "jlee",
  "scripts": {
    "dev": "turbo run dev --filter=@mikan/desktop... --filter=@mikan/mastra...",
    "build": "turbo run build --filter=!@mikan/mobile",
    "typecheck": "turbo run typecheck --filter=!@mikan/mobile",
    "test": "turbo run test --filter=!@mikan/mobile",
    "dev:desktop": "turbo run dev --filter=@mikan/desktop... --filter=@mikan/token-broker...",
    "build:desktop": "turbo run build --filter=@mikan/desktop... --filter=@mikan/token-broker...",
    "dev:mobile": "turbo run dev --filter=@mikan/mobile...",
    "build:mobile": "turbo run build --filter=@mikan/mobile...",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "gen:api": "pnpm --filter @mikan/contract gen:api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  }
}
