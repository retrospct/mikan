{
  "name": "@mikan/brand",
  "version": "1.5.0",
  "description": "The mikan brand layer: product identity (Mikan) + platform-agnostic design tokens. Consumed from source by the desktop app (web adapter) and the React Native/Expo mobile app (native adapter).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./identity.json": "./src/identity.json",
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
