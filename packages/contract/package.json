{
  "name": "@mikan/contract",
  "version": "1.5.0",
  "description": "The mikan backend⇄UI contract: IPC channels, view-model types, and the shared HTTP API client. Consumed from source by the desktop app (and a future RN/Expo app).",
  "private": true,
  "type": "module",
  "exports": {
    "./ipc": "./src/ipc.ts",
    "./views": "./src/views.ts",
    "./api": "./src/api/index.ts",
    "./api/token-store": "./src/api/token-store.ts",
    "./api/runtime": "./src/api/runtime.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:api": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
