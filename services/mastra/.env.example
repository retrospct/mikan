# Vercel AI Gateway — the Nimi agent routes its LLM calls through here.
# The AI SDK v6 gateway provider reads AI_GATEWAY_API_KEY by default; the model
# helper (src/model.ts) wires it explicitly. Create a token in the Vercel
# dashboard → AI Gateway.
AI_GATEWAY_API_KEY=

# Inngest pipeline LLM call (step.ai.infer) uses Inngest's own @inngest/ai
# adapter, which speaks the Anthropic-native API rather than the AI SDK gateway
# provider. It reuses AI_GATEWAY_API_KEY and (optionally) AI_GATEWAY_BASE_URL to
# point at the gateway's Anthropic-compatible endpoint; if unset it falls back
# to ANTHROPIC_API_KEY against api.anthropic.com.
AI_GATEWAY_BASE_URL=
ANTHROPIC_API_KEY=

# Inngest — from https://app.inngest.com/settings/signing-key
# Leave blank to use the local dev server (inngest:dev script)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
