# Anthropic — used by the Nimi agent
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Inngest — from https://app.inngest.com/settings/signing-key
# Leave blank to use the local dev server (inngest:dev script)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel AI Gateway (optional — replaces ANTHROPIC_API_KEY when set)
# Lets you route through Vercel's unified LLM proxy with caching + fallback
VERCEL_AI_GATEWAY_TOKEN=
