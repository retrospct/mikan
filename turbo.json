{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Turbo 2.x runs tasks in strict env mode (only declared vars reach the task).
  // Declare the vars the desktop app reads at build/dev time so they pass through
  // electron-vite: the embedder seam (`NEEME_EMBEDDER=hash` offline fallback) and
  // the renderer's API base URL (`VITE_NEEME_API_URL`). NEEME_USER_DATA is set by
  // main when it forks the worker (runtime, in-process) — not via the shell — so it
  // doesn't need declaring here.
  "globalEnv": ["NEEME_*", "VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
